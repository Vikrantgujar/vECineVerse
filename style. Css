<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VikrantCineVerse</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #101010;
      color: white;
    }
    header {
      background: #080808;
      padding: 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      border-bottom: 1px solid #292929;
    }
    .logo { color: #e50914; font-size: 23px; font-weight: bold; }
    input, select {
      padding: 11px;
      border-radius: 6px;
      border: 1px solid #555;
      background: #222;
      color: white;
      max-width: 100%;
    }
    .hero {
      padding: 55px 22px;
      background: linear-gradient(90deg, #251010, #111);
    }
    .hero h1 { font-size: 38px; margin: 0 0 12px; }
    .hero p { color: #ccc; }
    button {
      padding: 11px 17px;
      background: #e50914;
      color: white;
      border: 0;
      border-radius: 5px;
      cursor: pointer;
    }
    main { padding: 22px; }
    .movies {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
      gap: 16px;
    }
    .movie {
      background: #202020;
      border-radius: 8px;
      overflow: hidden;
      padding-bottom: 13px;
    }
    .poster {
      height: 175px;
      display: grid;
      place-items: center;
      background: linear-gradient(145deg, #562020, #171717);
      font-size: 45px;
    }
    .movie h3, .movie p { margin: 10px; }
    .movie p { color: #bbb; font-size: 13px; }
    .movie button { margin: 0 10px; }
    footer { padding: 25px; text-align: center; color: #aaa; }
  </style>
</head>
<body>
  <header>
    <div class="logo">VikrantCineVerse</div>
    <select id="language" aria-label="Language">
      <option value="en">English</option>
      <option value="mr">मराठी</option>
      <option value="hi">हिंदी</option>
    </select>
    <input id="search" placeholder="Search movies..." aria-label="Search movies">
  </header>

  <section class="hero">
    <h1 id="welcome">Unlimited Entertainment</h1>
    <p>Discover movies, web series and trailers in your favourite language.</p>
    <button onclick="document.getElementById('catalog').scrollIntoView()">Explore Now</button>
  </section>

  <main>
    <h2 id="heading">Popular Movies & Web Series</h2>
    <div class="movies" id="catalog"></div>
    <p id="empty" hidden>No titles found.</p>
  </main>

  <footer>© 2026 VikrantCineVerse | Made for movie lovers</footer>

  <script>
    const titles = [
      {name:"Action World", type:"Movie", icon:"🎬", lang:"English"},
      {name:"Mystery House", type:"Web Series", icon:"🕵️", lang:"Hindi"},
      {name:"Comedy Nights", type:"Web Series", icon:"😂", lang:"Hindi"},
      {name:"Space Journey", type:"Movie", icon:"🚀", lang:"English"},
      {name:"Marathi Stories", type:"Movie", icon:"🎭", lang:"Marathi"},
      {name:"Adventure Land", type:"Movie", icon:"🌍", lang:"English"}
    ];

    const catalog = document.getElementById("catalog");
    const search = document.getElementById("search");

    function render() {
      const query = search.value.toLowerCase();
      const filtered = titles.filter(item =>
        (item.name + " " + item.type + " " + item.lang)
          .toLowerCase().includes(query)
      );

      catalog.innerHTML = filtered.map(item => `
        <article class="movie">
          <div class="poster">${item.icon}</div>
          <h3>${item.name}</h3>
          <p>${item.type} · ${item.lang}</p>
          <button onclick="alert('Trailer link will be added here.')">View Trailer</button>
        </article>
      `).join("");

      document.getElementById("empty").hidden = filtered.length > 0;
    }

    search.addEventListener("input", render);

    document.getElementById("language").addEventListener("change", event => {
      const lang = event.target.value;
      document.getElementById("welcome").textContent =
        lang === "mr" ? "मनोरंजनाचे जग" :
        lang === "hi" ? "मनोरंजन की दुनिया" :
        "Unlimited Entertainment";
      document.getElementById("heading").textContent =
        lang === "mr" ? "चित्रपट आणि वेब सिरीज" :
        lang === "hi" ? "फिल्में और वेब सीरीज" :
        "Popular Movies & Web Series";
    });

    render();
  </script>
</body>
</html>
